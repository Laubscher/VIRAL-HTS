#!/bin/bash
TEMPNAME=$1
echo $TEMPNAME
CPU=$2
pathIndex=$3
pathIndex=/home/florian/myTools/Trimmomatic-0.36/TruSeqNexteraAdaptersAll.fa
#adapteur

 java -jar /home/florian/myTools/Trimmomatic-0.36/trimmomatic-0.36.jar PE -threads $CPU -basein $(echo $TEMPNAME)_R1_001.fastq -baseout  $(echo $TEMPNAME).fq ILLUMINACLIP:$pathIndex:1:30:7:1:true MINLEN:65 ;

 mv  $(echo $TEMPNAME)_1P.fq $(echo $TEMPNAME)_tr_R1_001.fastq ;

 mv  $(echo $TEMPNAME)_2P.fq $(echo $TEMPNAME)_tr_R2_001.fastq ;

#lowquality

 java -jar /home/florian/myTools/Trimmomatic-0.36/trimmomatic-0.36.jar PE -threads $CPU -basein $(echo $TEMPNAME)_tr_R1_001.fastq -baseout $(echo $TEMPNAME).fq MAXINFO:40:0.3 LEADING:10 TRAILING:10 MINLEN:65 ;

 mv $(echo $TEMPNAME)_1P.fq $(echo $TEMPNAME)_tr_R1_001.fastq ;

 mv $(echo $TEMPNAME)_2P.fq $(echo $TEMPNAME)_tr_R2_001.fastq ;

 rm $(echo $1)_1U.fq
 rm $(echo $1)_2U.fq

 bash src/rmdup $1 >> run.log